 HRESULT WINAPI WICCreateImagingFactory_Proxy(UINT, IWICImagingFactory**);
+
+static BOOL has_transparent_entry(IWICImagingFactory *factory, IWICBitmapSource *src)
+{
+    WICColor colors[256];
+    IWICPalette *palette;
+    UINT count = 0, i;
+    BOOL ret = FALSE;
+
+    if (FAILED(IWICImagingFactory_CreatePalette(factory, &palette))) return FALSE;
+    if (SUCCEEDED(IWICBitmapSource_CopyPalette(src, palette)) &&
+        SUCCEEDED(IWICPalette_GetColors(palette, ARRAY_SIZE(colors), colors, &count)))
+    {
+        for (i = 0; i < count; i++)
+            if ((colors[i] >> 24) != 0xff) { ret = TRUE; break; }
+    }
+    IWICPalette_Release(palette);
+    return ret;
+}
 

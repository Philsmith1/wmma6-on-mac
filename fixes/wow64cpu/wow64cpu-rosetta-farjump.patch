@@ -298,6 +310,21 @@
                    "jmp syscall_32to64_return\n" )
 
 
+
+#define SYSCALL_THUNK_OFF 0
+#define UNIX_THUNK_OFF    16
+
+/* Rosetta 2 mishandles far jumps between 32-bit and 64-bit code (ljmp ptr16:32 and ljmp *m16:32).
+ * Enter 64-bit code with a far return instead: push $cs64; push $target; lret */
+static void write_entry_thunk( BYTE *p, ULONG addr, USHORT cs )
+{
+    ULONG sel = cs;
+
+    p[0] = 0x68; memcpy( p + 1, &sel, 4 );   /* push $cs64 */
+    p[5] = 0x68; memcpy( p + 6, &addr, 4 );  /* push $addr */
+    p[10] = 0xcb;                             /* lret */
+}
+
